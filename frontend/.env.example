# Copia este archivo como .env y llena los valores.

# Conexión a la base de datos (Neon).
DATABASE_URL=

# Dirección pública de la app de choferes. Los enlaces que se envían a cada
# chofer quedan como <CHOFERES_URL>/c/<token>. Si falta, se usa
# http://localhost:3001 (la app de choferes corriendo en desarrollo).
CHOFERES_URL=
